{
	"manifest_version": 3,
	"name": "Favnekon3 Maker",
	"description": "__MSG_appDesc__",
	"version": "4.0",
	"default_locale": "en_US",
	"background": {
		"service_worker": "background.js"
	},
	"action": {
	  "default_icon": "icons/n3k@64.png",
	  "default_popup": "popup_db.html"
	},
	"web_accessible_resources": [
		{"resources": ["tools/*", "content_styles.css"], "matches": ["<all_urls>"]}
	],
	"host_permissions": ["<all_urls>"],
	"permissions": [
		"contextMenus",
		"scripting",
		"tabs"
	],
	"icons": {
		"64" : "icons/n3k@64.png",
		"128": "icons/n3k@128.png"
	}
}
